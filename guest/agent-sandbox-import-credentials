#!/bin/sh
set -eu

STAGING="${1:-/run/agent-sandbox/credentials}"
GUEST_USER="${2:-agent}"
HOME_DIR="$(getent passwd "$GUEST_USER" | cut -d: -f6)"

if [ -z "$HOME_DIR" ] || [ ! -d "$HOME_DIR" ]; then
  echo "agent-sandbox-import-credentials: unknown guest user: $GUEST_USER" >&2
  exit 1
fi

if [ ! -d "$STAGING" ]; then
  exit 0
fi

# Track the top-level entries we import so ownership can be fixed up without a
# recursive chown over the whole agent home (which holds the npm-global tooling).
imported=""
for profile_dir in "$STAGING"/*; do
  [ -d "$profile_dir" ] || continue
  [ "$(basename "$profile_dir")" = "env" ] && continue
  for entry in "$profile_dir"/.* "$profile_dir"/*; do
    name="$(basename "$entry")"
    case "$name" in . | .. | '.*' | '*') continue ;; esac
    [ -e "$entry" ] || continue
    imported="$imported $name"
  done
  cp -R "$profile_dir"/. "$HOME_DIR"/
done

ENV_FILE="$HOME_DIR/.agent-sandbox-env"
: > "$ENV_FILE"
if [ -d "$STAGING/env" ]; then
  for env_file in "$STAGING/env"/*; do
    [ -f "$env_file" ] || continue
    name="$(basename "$env_file")"
    case "$name" in
      *[!A-Za-z0-9_]* | [0-9]* | "")
        echo "agent-sandbox-import-credentials: skipping invalid env name: $name" >&2
        continue
        ;;
    esac
    value="$(sed "s/'/'\\\\''/g" "$env_file")"
    printf "export %s='%s'\n" "$name" "$value" >> "$ENV_FILE"
  done
fi

# Chown only the imported entries and the env file rather than the entire home
# tree, so import cost scales with the credential set, not the installed tooling.
for name in $imported; do
  chown -R "$GUEST_USER:$GUEST_USER" "$HOME_DIR/$name" 2>/dev/null || true
done
chown "$GUEST_USER:$GUEST_USER" "$ENV_FILE" 2>/dev/null || true
chmod 700 "$HOME_DIR/.ssh" 2>/dev/null || true
find "$HOME_DIR/.ssh" -type f -exec chmod 600 {} \; 2>/dev/null || true
chmod 600 "$ENV_FILE"
