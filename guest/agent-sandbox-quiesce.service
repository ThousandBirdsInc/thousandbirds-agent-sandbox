[Unit]
Description=Thousand Birds Agent Sandbox Quiesce Daemon
Documentation=https://github.com/thousandbirds/agent-sandbox
After=local-fs.target
Before=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/agent-sandbox-quiesce
Restart=always
RestartSec=2
KillMode=mixed
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
